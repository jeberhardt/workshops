#!/usr/bin/env bash
# workshop: set up the Pi, and install and control the workshop control panel.
#
# The control panel (control.py) runs the two workshop servers and shows a web
# page at http://<pi-ip>:8080 with Start / Stop / Restart buttons and live output
# for each one. This command does the same things from a terminal or over SSH.
#
# Setup (on the Pi, in the folder with pi_bridge.py and control.py, as your
# normal user, not with sudo). Safe to run again, e.g. after a git pull:
#   chmod +x workshop && ./workshop install
# It creates the .venv, installs the Python packages (requirements.txt and
# requirements-pi.txt), turns on I2C and SPI, steadies the SPI clock on a Pi 3/4
# (the NeoPixels need it), and installs the control panel so it starts at boot.
#
# Then:
#   workshop start   [bridge|http|all]     (default: all)
#   workshop stop    [bridge|http|all]
#   workshop restart [bridge|http|all]
#   workshop status
#   workshop logs    bridge|http           (follow live output, Ctrl+C to exit)
#   workshop uninstall

set -euo pipefail

PANEL_PORT=8080
PANEL="http://localhost:$PANEL_PORT"

ip_addr() { hostname -I | awk '{print $1}'; }

is_pi5() { tr -d '\0' < /proc/device-tree/model 2>/dev/null | grep -q "Raspberry Pi 5"; }

step() { echo; echo "== $*"; }

# The Python packages: the shared ones and the Pi-only ones.
install_packages() {
  local dir="$1" py="$2"
  step "Installing Python packages"
  "$py" -m pip install -r "$dir/requirements.txt" -r "$dir/requirements-pi.txt"
}

# Sets key=value in the Pi's config.txt, unless it's already set. NEEDS_REBOOT=1 if it changed.
set_boot_config() {
  local key="$1" value="$2" cfg=/boot/firmware/config.txt
  [[ -f "$cfg" ]] || cfg=/boot/config.txt
  if grep -q "^$key=$value\$" "$cfg"; then
    echo "$key=$value already set."
    return
  fi
  if grep -q "^$key=" "$cfg"; then
    sudo sed -i "s/^$key=.*/$key=$value/" "$cfg"
  else
    echo "$key=$value" | sudo tee -a "$cfg" >/dev/null
  fi
  echo "Set $key=$value in $cfg."
  NEEDS_REBOOT=1
}

# I2C (the ADS1115) and SPI (the NeoPixels, and the MCP3008 if used). On a Pi 3/4
# the SPI clock follows the chip's speed, which changes as it works harder; the
# NeoPixels need a steady clock, so fix it. (A Pi 5's SPI has its own clock.)
# Sets NEEDS_REBOOT=1 when a change only works after a reboot.
NEEDS_REBOOT=0
setup_interfaces() {
  step "Turning on I2C and SPI"
  if ! command -v raspi-config >/dev/null; then
    echo "raspi-config not found: turn on I2C and SPI yourself."
    return
  fi
  if [[ "$(sudo raspi-config nonint get_i2c)" != 0 ]]; then
    sudo raspi-config nonint do_i2c 0 && echo "I2C turned on." && NEEDS_REBOOT=1
  else echo "I2C already on."; fi
  if [[ "$(sudo raspi-config nonint get_spi)" != 0 ]]; then
    sudo raspi-config nonint do_spi 0 && echo "SPI turned on." && NEEDS_REBOOT=1
  else echo "SPI already on."; fi

  if is_pi5; then
    return
  fi
  step "Steadying the SPI clock for the NeoPixels"
  if tr -d '\0' < /proc/device-tree/model 2>/dev/null | grep -q "Raspberry Pi 4\|Raspberry Pi 400\|Compute Module 4"; then
    set_boot_config core_freq 500
    set_boot_config core_freq_min 500
  else
    set_boot_config core_freq 250
  fi
}

install() {
  local dir user py
  dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
  user="$(id -un)"
  [[ -f "$dir/control.py" ]] || { echo "control.py must be in the same folder as this script ($dir)."; exit 1; }
  if [[ "$EUID" == 0 ]]; then
    echo "Run this as your normal user, without sudo: ./workshop install (it asks for sudo when it needs it)."
    exit 1
  fi

  # The project's virtual environment: use the one that's there, or make .venv.
  # --system-site-packages lets it use the gpiozero that comes with Raspberry Pi OS.
  if   [[ -x "$dir/.venv/bin/python" ]]; then py="$dir/.venv/bin/python"
  elif [[ -x "$dir/venv/bin/python"  ]]; then py="$dir/venv/bin/python"
  else
    step "Creating the virtual environment (.venv)"
    python3 -m venv --system-site-packages "$dir/.venv"
    py="$dir/.venv/bin/python"
  fi

  install_packages "$dir" "$py"
  setup_interfaces

  step "Installing the control panel"

  # Remove the separate services from the earlier version of this script, if present.
  for old in p5-bridge p5-http; do
    if [[ -f "/etc/systemd/system/$old.service" ]]; then
      sudo systemctl disable --now "$old" 2>/dev/null || true
      sudo rm -f "/etc/systemd/system/$old.service"
    fi
  done

  echo "Installing control panel for user '$user', folder $dir, python $py"
  sudo tee /etc/systemd/system/p5-control.service >/dev/null <<EOF
[Unit]
Description=Workshop control panel (port $PANEL_PORT)
After=network-online.target
Wants=network-online.target

[Service]
User=$user
WorkingDirectory=$dir
ExecStart=$py -u $dir/control.py
Restart=on-failure
RestartSec=2
KillMode=mixed

[Install]
WantedBy=multi-user.target
EOF

  sudo systemctl daemon-reload
  sudo systemctl enable p5-control
  sudo systemctl restart p5-control      # restart, so the servers load any new packages
  sudo ln -sf "$dir/workshop" /usr/local/bin/workshop
  sleep 1
  echo
  echo "Done. Control panel: http://$(ip_addr):$PANEL_PORT  (starts automatically at boot)"
  if [[ "$NEEDS_REBOOT" == 1 ]]; then
    echo
    echo "Reboot once so the I2C, SPI and clock changes take effect:  sudo reboot"
  fi
}

uninstall() {
  sudo systemctl disable --now p5-control 2>/dev/null || true
  sudo rm -f /etc/systemd/system/p5-control.service /usr/local/bin/workshop
  sudo systemctl daemon-reload
  echo "Control panel removed."
}

need_panel() {
  curl -fsS "$PANEL/api/status" >/dev/null 2>&1 || {
    echo "The control panel isn't running. Start it with: sudo systemctl start p5-control"
    exit 1
  }
}

target() {
  case "${1:-all}" in
    bridge|http|all) echo "${1:-all}" ;;
    *) echo "Unknown server '$1'. Use bridge, http or all." >&2; exit 1 ;;
  esac
}

status() {
  need_panel
  curl -fsS "$PANEL/api/status" | python3 -c '
import json, sys
for name, s in json.load(sys.stdin).items():
    if s["running"]:
        state = "running (pid %s)" % s["pid"]
    elif s.get("crashed"):
        state = "CRASHED (exit %s), see: workshop logs %s" % (s["exit_code"], name)
    else:
        state = "stopped"
    print("%-7s %-20s port %-5s %s" % (name, s["label"], s["port"], state))'
  local ip; ip="$(ip_addr)"
  echo
  echo "Control panel: http://$ip:$PANEL_PORT"
  echo "Sketch page:   http://$ip:8000"
  echo "WebSocket:     ws://$ip:8765"
}

logs() {
  need_panel
  local name="${1:-}"
  [[ "$name" == bridge || "$name" == http ]] || { echo "Usage: workshop logs bridge|http"; exit 1; }
  python3 - "$PANEL" "$name" <<'PY'
import json, sys, time, urllib.request
panel, name = sys.argv[1], sys.argv[2]
seq = 0
try:
    while True:
        with urllib.request.urlopen(f"{panel}/api/logs/{name}?since={seq}") as r:
            data = json.load(r)
        if data["seq"] < seq:
            seq = 0
            continue
        for _, t, text in data["lines"]:
            print(f"{t}  {text}", flush=True)
        seq = data["seq"]
        time.sleep(0.5)
except KeyboardInterrupt:
    pass
PY
}

act() {
  need_panel
  local t; t="$(target "${2:-all}")"
  curl -fsS -X POST "$PANEL/api/$t/$1" >/dev/null
  status
}

case "${1:-status}" in
  install)   install ;;
  uninstall) uninstall ;;
  start|stop|restart) act "$1" "${2:-all}" ;;
  status)    status ;;
  logs)      logs "${2:-}" ;;
  *) echo "Usage: workshop {start|stop|restart} [bridge|http|all] | status | logs bridge|http | install | uninstall"; exit 1 ;;
esac
